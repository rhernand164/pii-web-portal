<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PII Data Sanitizer - Palo Alto Networks</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="logo">
            <img src="top-left.png" alt="Palo Alto Networks" height="40">
        </div>
        <div class="header-title">
            <h1>PII Data Sanitizer</h1>
        </div>
    </header>

    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="upload-section">
                <div id="dropZone" class="drop-zone">
                    <div class="drop-zone-content">
                        <svg class="upload-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        <p class="drop-text">Drop file here or click to browse</p>
                        <p class="drop-subtext">Supported: CSV, XLSX, XLS</p>
                    </div>
                    <input type="file" id="fileInput" accept=".csv,.xlsx,.xls" hidden>
                </div>

                <div id="fileInfo" class="file-info" style="display: none;">
                    <div class="file-ready">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <div>
                            <p class="file-ready-text">File Ready:</p>
                            <p class="file-name" id="fileName"></p>
                        </div>
                    </div>
                </div>

                <button id="sanitizeBtn" class="btn-primary" disabled>
                    <span id="btnText">Sanitize File</span>
                    <span id="btnSpinner" class="spinner" style="display: none;"></span>
                </button>

                <div id="statusBox" class="status-box">
                    <p id="statusText">Ready to sanitize files</p>
                </div>
            </div>

            <div class="info-section">
                <h3>About PII Sanitization</h3>
                <p>This tool uses hybrid AI technology to detect and remove personally identifiable information (PII) from your data files.</p>
                <ul class="info-list">
                    <li>Removes names, emails, phone numbers</li>
                    <li>Detects locations and addresses</li>
		    <li>Detects passwords, keys, secretes, etc </i>
                    <li>Preserves data structure</li>
                    <li>Secure processing</li>
                </ul>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="hero-section">
                <div class="hero-icon">
                    <svg width="80" height="80" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
                        <rect x="15" y="15" width="15" height="50" fill="#FF6600" opacity="0.3" transform="rotate(-10 22.5 40)"/>
                        <rect x="32.5" y="15" width="15" height="50" fill="#FF6600" opacity="0.6" transform="rotate(10 40 40)"/>
                        <rect x="50" y="15" width="15" height="50" fill="#FF6600" transform="rotate(-10 57.5 40)"/>
                    </svg>
                </div>
                <h2>Secure PII Data Sanitization</h2>
                <p class="hero-description">
                    Upload your CSV or Excel files to automatically detect and remove personally identifiable information. 
                    Our hybrid detection system combines deterministic rules with AI-powered analysis for comprehensive PII protection.
                </p>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🔒</div>
                    <h3>Secure Processing</h3>
                    <p>Files are processed locally and never stored permanently</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🤖</div>
                    <h3>Hybrid AI Detection</h3>
                    <p>Combines rule-based and LLM-powered PII detection</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h3>Fast & Accurate</h3>
                    <p>Efficient processing while maintaining data integrity</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📊</div>
                    <h3>Format Preservation</h3>
                    <p>Maintains your original data structure and formatting</p>
                </div>
            </div>

            <div class="supported-formats">
                <h3>Supported File Formats</h3>
                <div class="format-badges">
                    <span class="badge">CSV</span>
                    <span class="badge">XLSX</span>
                    <span class="badge">XLS</span>
                </div>
            </div>
        </main>
    </div>

    <!-- Success Modal -->
    <div id="successModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-icon success">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <h2>Sanitization Complete!</h2>
            <p>Your file has been successfully sanitized and downloaded.</p>
            <button id="sanitizeAnother" class="btn-primary">Sanitize Another File</button>
        </div>
    </div>

    <!-- Error Modal -->
    <div id="errorModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-icon error">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
            <h2>Sanitization Failed</h2>
            <p id="errorMessage">An error occurred during sanitization.</p>
            <button id="closeError" class="btn-secondary">Close</button>
        </div>
    </div>

    <script src="app.js"></script>
</body>
</html>
